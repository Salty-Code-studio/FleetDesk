# =============================================================================
# .env.example  —  copy to .env.local and fill in REAL values.
# NEVER commit .env.local (it is gitignored). NEVER put real secrets in THIS file.
# Every variable here is validated at boot by src/env.ts (fail-closed).
# =============================================================================

# Runtime environment. One of: development | test | production
NODE_ENV=development

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
# Public origin of THIS API (used to set the `secure` cookie attr & for logs).
APP_ORIGIN=http://localhost:3000

# Comma-separated list of EXACT origins allowed to call the API via CORS.
# Deny-by-default: anything not on this list gets no CORS headers.
# Example for prod: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------------------
# Session cookie auth  —  generate with:  openssl rand -base64 48
# Used to sign opaque session IDs.
# ----------------------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_generate_a_DIFFERENT_value_openssl_rand_base64_48___
SESSION_TTL_SECONDS=86400

# ----------------------------------------------------------------------------
# Rate limiting (in-memory token bucket for the starter; swap for Redis in prod)
# ----------------------------------------------------------------------------
# Global per-IP budget.
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
# Stricter budget for auth routes (brute-force / credential-stuffing defense).
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# Trust client-supplied X-Forwarded-For / X-Real-IP for the rate-limit client
# key. KEEP false unless this app runs behind a reverse proxy / platform edge
# that OVERWRITES those headers — otherwise attackers spoof them to evade the
# brute-force limiter. true | false
TRUST_PROXY=false

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# One of: debug | info | warn | error
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Database
#   Local dev / tests:  pglite://<dir>  (zero-install Postgres, no server)
#   Production:         postgres://...  (Supabase or Neon)
#
# SUPABASE: create a project, then Project Settings -> Database -> Connection
# string. You get two host:port pairs for the SAME database:
#   • Transaction pooler (...pooler.supabase.com:6543) -> DATABASE_URL (runtime).
#     Right for serverless/Vercel: many short-lived connections. Append
#     ?sslmode=require. `prepare:false` is already set in code for the pooler.
#   • Direct connection (db.<ref>.supabase.co:5432)    -> DATABASE_MIGRATION_URL
#     (DDL / migrations). Leave empty to migrate over DATABASE_URL instead.
# The btree_gist extension the booking constraint needs is created automatically
# by migration 0002 (CREATE EXTENSION IF NOT EXISTS btree_gist) — nothing to do.
# ----------------------------------------------------------------------------
DATABASE_URL=pglite://.dev-db
DATABASE_MIGRATION_URL=

# ----------------------------------------------------------------------------
# Field encryption key (license PII)  —  generate with:  openssl rand -base64 32
# Must decode to exactly 32 bytes. Rotating it requires re-encrypting stored rows.
# ----------------------------------------------------------------------------
DATA_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32________________

# ----------------------------------------------------------------------------
# Stripe (payments)  —  prefer a RESTRICTED key (rk_) over a secret key (sk_).
# Test keys from the Stripe dashboard; webhook secret from `stripe listen` or
# the dashboard endpoint. NEVER commit real keys.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=CHANGE_ME_rk_test_your_restricted_key
STRIPE_WEBHOOK_SECRET=CHANGE_ME_whsec_your_webhook_signing_secret

# ----------------------------------------------------------------------------
# Email (Resend)  —  OPTIONAL. Leave empty to disable transactional email.
# Get a key at resend.com; EMAIL_FROM must be a verified sender/domain.
# ----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=FleetDesk <bookings@fleetdesk.app>

# ----------------------------------------------------------------------------
# Upstash Redis (rate-limit store)  —  OPTIONAL but RECOMMENDED in production
# so the rate limiter coordinates across serverless instances. Get both at
# upstash.com. Without these, the in-memory per-instance limiter is used.
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduled maintenance cron secret (hold expiry). Generate: openssl rand -hex 32
# Vercel Cron sends this as a Bearer token; the endpoint refuses without it.
CRON_SECRET=

# ----------------------------------------------------------------------------
# Owner WhatsApp alerts (Meta WhatsApp Business Cloud API) — OPTIONAL.
# Set ALL THREE to also push owner alerts (new booking, payment) to WhatsApp;
# leave any empty and that channel is skipped (email still works). The owner
# must create a WhatsApp Business app + number and a permanent access token.
#   WHATSAPP_TOKEN     — permanent access token (Bearer)
#   WHATSAPP_PHONE_ID  — the WhatsApp Business phone-number id
#   WHATSAPP_OWNER_TO  — the owner's number in E.164, e.g. 15551234567
# ----------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OWNER_TO=
