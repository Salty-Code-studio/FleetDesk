{
  "name": "fleetdesk",
  "version": "1.0.0",
  "private": true,
  "description": "FleetDesk - booking + operations platform (Phase 2)",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "predev": "node --import tsx --env-file-if-exists=.env.local scripts/check-env.ts",
    "dev": "next dev",
    "prebuild": "node --import tsx --env-file-if-exists=.env.local scripts/check-env.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "node --import tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "admin:create": "node --import tsx --env-file-if-exists=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "argon2": "0.41.1",
    "drizzle-orm": "^0.45.2",
    "next": "15.3.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.12.4",
    "stripe": "^22.2.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/node": "22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.17.0",
    "eslint-config-next": "15.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "^4.1.8"
  }
}
